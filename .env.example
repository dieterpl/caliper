# Copy to .env before `docker compose up`.

# Shared password for the workbench. Optional for localhost; required for LAN
# access. Anyone with this token can run commands and access mounted agent
# credentials. Use HTTPS when accessing it over a network. Generate a token:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
WEB_TOKEN=

# Where the port is published. 0.0.0.0 reaches the LAN (phone, another laptop);
# 127.0.0.1 keeps it to this machine.
BIND_ADDR=127.0.0.1
PORT=8017

# Whose login the agents use. The default is the ~/.claude you already have.
CLAUDE_HOME=

# Who commits show up as.
GIT_AUTHOR_NAME=caliper
GIT_AUTHOR_EMAIL=caliper@localhost

# Optional: use an API key instead of the mounted ~/.claude login. Passed
# through to the agents; leave empty to use the login.
ANTHROPIC_API_KEY=

# Codex and Gemini are also installed. Their interactive logins are saved on
# caliper-state. Codex uses its own ChatGPT account login via Add > Sign in to
# Codex; no OpenAI API key is needed. Optional Gemini API credentials:
GEMINI_API_KEY=

# Optional npm version pins for repeatable CLI image builds.
CLAUDE_CLI_VERSION=latest
CODEX_CLI_VERSION=latest
GEMINI_CLI_VERSION=latest

# Which butai release the image installs. `latest` (the default) takes whatever
# is current at build time; pin a tag — BUTAI_VERSION=v1.1.1 — when you want two
# builds to be the same image. caliper needs butai 1.0.0 or newer.
BUTAI_VERSION=latest
